# Database
spring.datasource.url=jdbc:mysql://localhost:3306/connectsphere_db
spring.datasource.username=root
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT — generate a long random string, do not reuse this example value
app.jwt.secret=CHANGE_ME_min_32_chars_random_string
app.jwt.expiry-ms=86400000

# Port
server.port=8081

logging.level.org.springframework.security=DEBUG

# Cloudinary — get these from https://cloudinary.com/console
cloudinary.cloud-name=CHANGE_ME
cloudinary.api-key=CHANGE_ME
cloudinary.api-secret=CHANGE_ME

spring.servlet.multipart.max-file-size=25MB
spring.servlet.multipart.max-request-size=25MB